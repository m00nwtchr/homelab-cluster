{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"github>home-operations/renovate-presets",
		"abandonments:recommended",
		// "m00n/homelab-cluster//.renovate/autoMerge.json5",
		// "m00n/homelab-cluster//.renovate/customManagers.json5",
		// "m00n/homelab-cluster//.renovate/grafana.json5",
		// "m00n/homelab-cluster//.renovate/groups.json5",
		// "m00n/homelab-cluster//.renovate/labels.json5",
		// "m00n/homelab-cluster//.renovate/semanticCommits.json5",
		// ":semanticCommits",
		":timezone(Europe/Warsaw)",
	],
	lockFileMaintenance: {
		enabled: true,
		schedule: ["before 3am on the first day of the month"],
		commitMessageExtra: "({{manager}})",
		additionalBranchPrefix: "{{manager}}-",
	},
	packageRules: [
		// Auto-merge rules
		{
			description: "Auto-merge trusted OCI digests",
			matchDatasources: ["docker"],
			matchUpdateTypes: ["digest"],
			matchPackageNames: ["/home-operations/", "/m00nwtchr/"],
			automerge: true,
			automergeType: "pr",
			ignoreTests: false,
		},
		{
			description: "Auto-merge game container updates",
			matchDatasources: ["docker"],
			automerge: true,
			automergeType: "pr",
			matchUpdateTypes: ["minor", "patch"],
			matchPackageNames: ["/pocketpairjp/"],
			ignoreTests: false,
		},
		{
			description: "Auto-merge high-cadence OCI packages weekly",
			matchDatasources: ["docker"],
			matchUpdateTypes: ["minor", "patch"],
			matchPackageNames: ["/kube-prometheus-stack/"],
			automerge: true,
			automergeType: "pr",
			ignoreTests: false,
			schedule: ["before 6am on Monday"],
		},
		{
			description: "Auto-merge GitHub Actions",
			matchManagers: ["github-actions"],
			matchUpdateTypes: ["minor", "patch", "digest"],
			automerge: true,
			automergeType: "branch",
			minimumReleaseAge: "3 days",
			ignoreTests: true,
		},
		{
			description: "Auto-merge trusted GitHub Actions",
			matchManagers: ["github-actions"],
			matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
			matchUpdateTypes: ["minor", "patch", "digest"],
			automerge: true,
			automergeType: "branch",
			minimumReleaseAge: "1 minute",
			ignoreTests: true,
		},
		{
			description: "Auto-merge Grafana dashboards",
			matchDatasources: ["custom.grafana-dashboards"],
			matchUpdateTypes: ["major"],
			automerge: true,
			automergeType: "branch",
			ignoreTests: true,
		},
		{
			description: "Auto-merge Renovate Presents",
			matchManagers: ["renovate-config"],
			matchUpdateTypes: ["minor", "patch"],
			automerge: true,
			automergeType: "branch",
			ignoreTests: true,
		},
		// Grouping rules
		{
			description: "Toolhive Group",
			groupName: "toolhive",
			matchDatasources: ["docker"],
			matchPackageNames: ["/toolhive/"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
		},
		{
			description: "Memini Group",
			groupName: "memini",
			matchPackageNames: ["/memini"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
		},
		{
			description: "Actions Runner Controller Group",
			groupName: "actions-runner-controller",
			matchDatasources: ["docker"],
			matchPackageNames: [
				"/gha-runner-scale-set-controller/",
				"/gha-runner-scale-set/",
			],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
		},
		{
			description: "Flux Operator Group",
			groupName: "flux-operator",
			matchDatasources: ["docker"],
			matchPackageNames: ["/flux-operator/", "/flux-instance/"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
		},
		{
			description: "Kubernetes Group",
			groupName: "kubernetes",
			matchDatasources: ["docker"],
			matchPackageNames: [
				"/kube-apiserver/",
				"/kube-controller-manager/",
				"/kube-proxy/",
				"/kube-scheduler/",
				"/kubelet/",
			],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 5,
		},
		{
			description: "Rook-Ceph Group",
			groupName: "rook-ceph",
			matchDatasources: ["docker"],
			matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
		},
		{
			// After the mise tools catch-all so talos wins its own group; unites the
			// mise pin, the factory installer image, and the tuppr upgrade version
			description: "Talos Group",
			groupName: "talos",
			matchPackageNames: ["siderolabs/talos"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
		},
		{
			description: "Agentgateway Group",
			groupName: "agentgateway",
			matchPackageNames: ["agentgateway", "agentgateway-crds"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 2,
			allowedVersions: "<2.0.0",
		},
		// Labeling rules
		{
			matchUpdateTypes: ["major"],
			addLabels: ["type/major"],
		},
		{
			matchUpdateTypes: ["minor"],
			addLabels: ["type/minor"],
		},
		{
			matchUpdateTypes: ["patch"],
			addLabels: ["type/patch"],
		},
		{
			matchUpdateTypes: ["digest"],
			addLabels: ["type/digest"],
		},
	],
	ignorePaths: ["**/*.sops.*", "**/resources/**", "**/old/**"],
}
